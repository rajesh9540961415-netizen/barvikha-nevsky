# Приватный бизнес-контекст — не уходит в git
.business/

# Учредительные и внутренние документы
НЕВСКИЙ Учредительные документы/
ДОКУМЕНТЫ для заполнения НЕВСКИЙ/

# Фото и видео объектов — 1,3 ГБ, в репозитории им делать нечего
Питер. Просмотры/

# Заполненные отчёты: там суммы и фамилии сотрудников.
# Скрипты, которые их создают, в репозитории есть — файлы не нужны.
Чаевые-дубль-*.xlsx
смена-*.json

# Разобранный ДДС: суммы, контрагенты, выручка по дням.
# Скрипт разбора (scripts/dds_import.py) в репозитории есть — данные не нужны.
data/dds/

# Пароли и доступы — никогда не уходят в git
.env

# Сессия Telegram. Это не файл настроек, а ключ: с ним можно войти
# в аккаунт без номера и кода из СМС.
scripts/.tg-session*

# macOS
.DS_Store

# Служебные файлы Word и Excel, пока документ открыт
~$*

# Готовый набор переменных для читателя QR — заливается в панель Amvera.
# Внутри пароль базы и ключ от аккаунта Telegram.
.env.reader
reader.env
