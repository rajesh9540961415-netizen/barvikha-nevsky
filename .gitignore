# .business/ УБРАН отсюда 11.08.2026 решением владельца — папка идёт в git.
#
# Он стоял тут как «приватный бизнес-контекст», но граница не выдержала
# проверки: в plans/, которые коммитятся, лежат номера расчётных счетов,
# заработки сотрудников поимённо и разбор банковских выписок. .business
# не чувствительнее — линия была проведена не по риску, а по привычке.
#
# Взамен папка получила то, чего у неё не было вовсе: копию и историю.
# 61 файл, 3,8 МБ, весь разбор бизнеса — экономика, себестоимость,
# аудитория, история решений — существовал в одном экземпляре на Маке.
#
# ⚠️ Что НЕ отменяется: `.env` в git не уходит никогда. Вот эта граница
# настоящая — там пароль от боевой базы и ключи Telegram.
#
# Перед добавлением .business проверена на пароли и ключи: чисто, слово
# «пароль» встречается только в описаниях.

# Учредительные и внутренние документы
НЕВСКИЙ Учредительные документы/
ДОКУМЕНТЫ для заполнения НЕВСКИЙ/

# Фото и видео объектов — 1,3 ГБ, в репозитории им делать нечего
Питер. Просмотры/

# Заполненные отчёты: там суммы и фамилии сотрудников.
# Скрипты, которые их создают, в репозитории есть — файлы не нужны.
Чаевые-дубль-*.xlsx
смена-*.json
# Свод вознаграждений и зарплат: фамилии и выплаты по каждому человеку.
# Попал в репозиторий 13.08.2026 по невнимательности — сохраняли «всё подряд».
/Свод вознаграждений*.xlsx
"/Резервные копии/Свод вознаграждений*.xlsx"

# Готовые отчёты в корне проекта: там выручка, суммы и выводы по бизнесу.
# Только корень — письма в plans/ остаются в репозитории, они рабочие.
/*.docx
# То же и для таблиц. Правило общее, а не по именам, нарочно: 18.08.2026
# «Возвраты без перебивки — 2026.xlsx» пролежала в корне незанесённой только
# потому, что её никто не добавил, — под запрет она не попадала. Следующий
# отчёт так же ждал бы своей строки в этом файле. Под гитом в корне ни одной
# таблицы нет и не было, так что общее правило ничего не отвязывает.
/*.xlsx
# Собранные страницы «Фин. свода»: контрагенты поимённо и все суммы.
# Сборщик описан в plans/2026-08-07-состояние-финучета.md — файлы не нужны.
/Фин-свод-*.xlsx

# Разобранный ДДС: суммы, контрагенты, выручка по дням.
# Скрипт разбора (scripts/dds_import.py) в репозитории есть — данные не нужны.
data/dds/

# Записи звонков, расшифровки и разборы: голоса гостей, их телефоны,
# содержание разговоров. Персональные данные — в git не уходят никогда.
# Скрипты обработки в репозитории есть, сами звонки не нужны.
data/calls/

# Скачанные смены: официанты поимённо и их заработок за вечер.
# Скрипт (scripts/report_pull.py) заберёт их у приложения заново в любой
# момент — хранить эти файлы в git незачем.
data/выгрузки-смен/

# Пароли и доступы — никогда не уходят в git
.env

# Сессия Telegram. Это не файл настроек, а ключ: с ним можно войти
# в аккаунт без номера и кода из СМС.
scripts/.tg-session*
# ⚠️ Отдельная сессия Мака: имя НЕ подходит под правило выше, и без этой
# строки файл-ключ уехал бы в репозиторий. Заведена 22.08.2026.
scripts/.tg-mac-session*

# macOS
.DS_Store

# Служебные файлы Word и Excel, пока документ открыт
~$*

# Готовый набор переменных для читателя QR — заливается в панель Amvera.
# Внутри пароль базы и ключ от аккаунта Telegram.
.env.reader
reader.env

# Файлы-двойники, которые плодит синхронизация папки «Документы»: рядом
# с service.py заводится «service 2.py», байт в байт такой же. Python их
# не подхватывает (пробел в имени), но две копии одного кода — ровно то,
# от чего этот проект бережётся везде. 14.08.2026 пять таких успели уехать
# в репозиторий и к роботу в бой: сохраняли «всё подряд», не глядя.
* 2.*
* 3.*

# Ключ служебного аккаунта Google — им робот пишет в таблицу управляющей
# компании. Это пароль: кто им завладел, пишет в чужие таблицы от нашего
# имени. В репозитории ему делать нечего.
data/certs/*.json

# Чеки из ОФД: позиции заказов, суммы, имена кассиров. В репозиторий не уходят —
# как и выгрузки смен. Кэш восстанавливается из API одной командой.
data/ofd/

# ── Персональные данные ───────────────────────────────────────────────────
# 25.08.2026 владелец решила «всё равно переноси» — 22.10.2026 решение
# отменено: 271 файл выведен из-под гита (на диске VPS лежат как были).
# ⚠️ В ИСТОРИИ они остаются — до переписывания (git filter-repo), которое
# владелец решает отдельно. В них паспортные данные, ИНН, ФИО работников
# и иностранных граждан, фотографии листов смен с именами и суммами.

# Документы по миграции и юридические: паспортные данные
data/*.pdf

# Фото бумажных листов смен и опись к ним: имена и суммы. README — описание
# папки, данных в нём нет, остаётся в гите.
data/листы-смен/*
!data/листы-смен/README.md

# Рабочие данные скриптов с именами и суммами. Скрипты читают их с диска,
# из гита — нет, так что работа от этих строк не меняется.
data/листы-бумага.json
data/вердикт-листа.json
data/отмены.json
data/отмены-суммы.json
data/чат-кассы.json
data/снимки-облака/

# Замок LibreOffice на открытый файл — в нём имя пользователя
.~lock.*#

# Копии .env — в них все ключи проекта. Папка «Резервные копии» в гите,
# и без этой строки такая копия однажды уедет в историю репозитория.
Резервные копии/.env*

# Скачанные заказы Quick Resto: позиции, суммы, официанты поимённо. 3,8 МБ,
# и это кэш — scripts/qr_orders.py забирает их у API заново. Ровно та же
# причина, по которой выше исключены data/ofd/ и data/выгрузки-смен/.
data/qr/

# Метка «за какой день вердикт уже ушёл в Telegram». Меняется каждое утро
# и принадлежит машине, а не проекту: в репозитории она давала бы правку
# в день и путала бы, кто кому что отправил. Читают proverka_utra.py
# и tips_telegram.py — оба переживают её отсутствие.
data/.вердикт-отправлен

# Замок очереди утренних задач — живёт только на этой машине
data/.очередь

# Ручные копии перед перезаписью (правило владельца: сохранять предыдущую
# версию файла-результата). В git их класть незачем — он и так хранит
# каждую прошлую версию, а копии весят 21 МБ и растут. Решение 22.09.2026.
Резервные копии/

# Разбор звонков с телефонами гостей и именами хостес — из-под гита
# по решению владельца 23.10.2026, лежит только на диске.
.business/quality/источники/Разбор_звонков_—_Невский_—_2026_07_16.pdf
