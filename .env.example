# ОБРАЗЕЦ файла .env — значения НЕ настоящие.
#
# Как пользоваться: скопируйте этот файл рядом под именем .env
#     cp .env.example .env
# и подставьте настоящие значения. Их выдаёт владелец — отдельно,
# через менеджер паролей. НЕ через почту, чат или гит.
#
# ⚠️ Сам .env в гит не уходит и уходить не должен: он в .gitignore,
# и за всю историю проекта не был закоммичен ни разу. Проверено 25.08.2026.
#
# ⚠️ Кавычки не нужны. Пробелы вокруг «=» не нужны.
#    Комментарий в той же строке, где значение, НЕ писать.

# Доступ к Quick Resto.
# Замените ЗАМЕНИТЕ_МЕНЯ на настоящие логин и пароль, сохраните файл.
# Кавычки не нужны, пробелы вокруг знака = не нужны.
# Этот файл не уходит в git и не попадает в чат.

QR_URL=https://XXXXX.quickresto.ru
QR_LOGIN=ЗАМЕНИТЕ_МЕНЯ
QR_PASSWORD=ЗАМЕНИТЕ_МЕНЯ

# Quick Resto: облако ООО «МАВ» (то же, что QR_URL выше — оставлено для явности)
QR_MAV_URL=https://XXXXX.quickresto.ru
QR_MAV_LOGIN=ЗАМЕНИТЕ_МЕНЯ
QR_MAV_PASSWORD=ЗАМЕНИТЕ_МЕНЯ

# Quick Resto: облако ИП Шалаева (вторая касса, с июля 2026)
QR_SHALAEVA_URL=https://XXXXX.quickresto.ru
QR_SHALAEVA_LOGIN=ЗАМЕНИТЕ_МЕНЯ
QR_SHALAEVA_PASSWORD=ЗАМЕНИТЕ_МЕНЯ

# Telegram: чтение уведомлений «СберЧаевые PRO» из группы «СберЧаевые Невский».
# Значения берутся на https://my.telegram.org под номером служебного аккаунта,
# раздел «API development tools». Вставьте их после знака = , без кавычек.
TG_API_ID=0000000
TG_API_HASH=ЗАМЕНИТЕ_МЕНЯ
# Список групп служебного аккаунта: python3 scripts/tg_groups.py
#
# ⚠️ ГРУПП С ИМЕНЕМ «Сберчаевые Нев» ДВЕ, и живая — только одна.
#
# 04.08.2026 группу преобразовали в супергруппу. Телеграм при этом не
# переименовывает старую, а заводит рядом новую: имя то же, номер другой,
# нумерация сообщений начата заново с единицы. Старая остаётся видимой
# и на вид исправной — в ней просто больше ничего не появляется.
#
#   -1003807015954   ЖИВАЯ, супергруппа. Сбер шлёт сюда
#   -5484146873      мёртвая, прежняя. Последнее поступление 04.08.2026 14:24
#
# Здесь до 14.08.2026 стоял мёртвый номер, и проверка руками из-за этого
# врала: показывала «тишина 10 суток, проверьте группу» — то есть в точности
# картину настоящей беды, хотя чаевые всё это время доезжали.
#
# ⚠️ Имя группы — не удостоверение личности. Прежде чем верить номеру, сверьте
# его с содержимым: python3 scripts/tg_read.py покажет, что в группе лежит.
#
# Прежняя группа -1003861873766 (до 04.08) не читается вовсе: Telegram
# отвечает ChannelPrivateError, аккаунт в ней не состоит. История оттуда
# не переехала, последнее поступление в ней было 26.07.2026 в 03:56.
#
# TG_GROUP_ID=-4765487440   ← НЕ подставлять: это рабочий чат сотрудников «МАВ»
TG_GROUP_ID=-1000000000000
CHAEVYE_EXPORT_KEY=ЗАМЕНИТЕ_МЕНЯ

# Ключ на ЗАПИСЬ финансов в бэк-офис, отдельный от ключа отчёта.
# То же значение должно стоять в переменных приложения nevsky-office
# в панели Amvera. План: plans/2026-08-15-razdel-finansy.md
FINANCE_KEY=ЗАМЕНИТЕ_МЕНЯ

# ── Первый ОФД ────────────────────────────────────────────────────────────
#
# ⚠️ У Первого ОФД ДВА разных интерфейса, и ключи у них разные.
#
# 1) КАССОВОЕ API — облачная касса, чтобы чеки ПРОБИВАТЬ.
#    Ключ выпускается сам, в кабинете: Интеграции → Ключи к Кассовому API
#    https://org.1-ofd.ru/cloud/integrations/api-keys-page
#    Для чтения чеков НЕ годится: 17.08.2026 проверено на живом API,
#    ответ «there is no Partner with secret».
#
# 2) API ДЛЯ СВЕРКИ — чтобы чеки ЧИТАТЬ, universal-api.1-ofd.ru
#    Ключ в кабинете не выпускается: только письмом на info@1-ofd.ru,
#    тема «Получение доступа к API для сверки».
#    Письмо готово: plans/Письмо в Первый ОФД — доступ к API.docx
#    ⚠️ Просить уровень «Данные по чекам, ВКЛЮЧАЯ НОМЕНКЛАТУРУ» — иначе
#    в ответе не будет названий и количества блюд, а без них проверка мертва.
#
# Кавычки не нужны. Комментарий в той же строке НЕ писать.

OFD_MAV_OKASSA_KEY=ЗАМЕНИТЕ_МЕНЯ

# Ключи API для сверки — появятся после ответа оператора:
OFD_MAV_SVERKA_KEY=ЗАМЕНИТЕ_МЕНЯ
OFD_SHALAEVA_SVERKA_KEY=ЗАМЕНИТЕ_МЕНЯ


# ─────────────────────────────────────────────────────────────────────
# 18. Рестоплейс — система бронирования. Нужен для сверки звонков
#     с реальными бронями и для проверки на депозиты, которых
#     на Невском быть не должно.
#
#     ⚠️ У КАЖДОГО АДРЕСА СВОЙ КЛЮЧ. Нужен именно невский, ключ другой
#     точки сети молча принесёт чужие брони — та же ловушка, что была
#     с общим облаком кассы бара.
#
#     Где взять: app.restoplace.cc → адрес «Невский» → настройки
#     (шестерёнка справа вверху) → левое меню «Интеграции» →
#     «API / Webhook» → тумблер «Включить API» → скопировать ключ.
#
#     Работает только на тарифе ПРО+. У Невского он с 2024 года
#     (владелец, 28.08.2026), поэтому история придёт за месяц целиком:
#     Рестоплейс отдаёт текущий месяц, и то если тариф действовал
#     весь месяц — иначе только неделю.
RP_API_KEY=ЗАМЕНИТЕ_МЕНЯ
