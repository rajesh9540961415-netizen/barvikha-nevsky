# Сборка бэк-офиса для Amvera.
#
# Это третье приложение проекта. Первое — то, куда смена вносит деньги,
# второе — читатель QR-чаевых. Разделены намеренно: сбой отчётов не должен
# мешать вносить чаевые в зале, а выкладка отчётов — класть приложение,
# которым в этот момент пользуется смена.

FROM node:22-alpine

WORKDIR /app

# Сначала только списки зависимостей: пока они не менялись, Docker
# переиспользует уже скачанное и не ставит всё заново при каждой правке.
COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

RUN npm run build

# Amvera обращается к приложению по порту 80 — так написано в панели рядом
# с внутренним именем. Next.js по умолчанию слушает 3000.
ENV PORT=80
EXPOSE 80

# Перед запуском приводим базу в соответствие со схемой.
#
# С компьютера владельца боевая база недоступна — VPN incy перехватывает
# соединения на порт 5432, обойти не вышло. А отсюда, из дата-центра Amvera,
# она достижима. Поэтому схему применяет само приложение при старте.
#
# Схема ничего не удаляет и не переписывает, только добавляет недостающее,
# и выполнять её можно сколько угодно раз. Не удалось — контейнер не
# поднимется, и причина будет видна в журнале панели: бэк-офис без нужных
# колонок всё равно сломается, только позже и непонятнее.
CMD ["sh", "-c", "node scripts/db-setup.mjs && npm start"]
