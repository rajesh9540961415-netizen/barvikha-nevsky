# Сборка бэк-офиса для Amvera.
#
# Это третье приложение проекта. Первое — то, куда смена вносит деньги,
# второе — читатель QR-чаевых. Разделены намеренно: сбой отчётов не должен
# мешать вносить чаевые в зале, а выкладка отчётов — класть приложение,
# которым в этот момент пользуется смена.

FROM node:22-alpine

WORKDIR /app

# Сначала только списки зависимостей: пока они не менялись, Docker
# переиспользует уже скачанное и не ставит всё заново при каждой правке.
COPY package.json package-lock.json ./
RUN npm ci

COPY . ./

RUN npm run build

# Amvera обращается к приложению по порту 80 — так написано в панели рядом
# с внутренним именем. Next.js по умолчанию слушает 3000.
ENV PORT=80
EXPOSE 80

CMD ["npm", "start"]
