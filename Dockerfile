# Сборка приложения для Amvera.
#
# Приложение лежит в подпапке mini-app, а Amvera собирает из корня репозитория.
# Dockerfile это и решает: берём из корня только то, что нужно приложению.
# Заодно версия Node зафиксирована здесь, а не в настройках панели — видно в коде.

FROM node:22-alpine

WORKDIR /app

# Сначала только списки зависимостей: пока они не менялись, Docker переиспользует
# уже скачанное и не ставит всё заново при каждой правке кода.
COPY mini-app/package.json mini-app/package-lock.json ./
RUN npm ci

COPY mini-app/ ./

# Отметка сборки — её видно на экране приложения и в /api/health.
#
# Без неё вопрос «что сейчас в бою» решается только археологией по бандлу,
# и 10.08.2026 это стоило полутора часов: локальная ветка master разошлась
# с сервером, а опознать версию по содержимому страницы не вышло.
#
# Пишем в .env.production, потому что Next.js читает этот файл при сборке
# и вшивает переменные с приставкой NEXT_PUBLIC_ прямо в код. Задать через
# ENV нельзя: там не выполняются команды, а время нужно на момент сборки.
#
# Дописываем (>>), а не перезаписываем: если файл появится в приложении
# для чего-то ещё, молча стирать его нельзя.
RUN echo "NEXT_PUBLIC_BUILD_TIME=$(date -u +'%Y-%m-%dT%H:%MZ')" >> .env.production

RUN npm run build

# Amvera обращается к приложению по порту 80 — так написано в панели рядом
# с внутренним именем. Next.js по умолчанию слушает 3000, поэтому порт
# задаём явно: next start читает переменную PORT.
ENV PORT=80
EXPOSE 80

CMD ["npm", "start"]
