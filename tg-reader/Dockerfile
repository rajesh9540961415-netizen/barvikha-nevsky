# Сборка читателя QR-чаевых для Amvera.
#
# Это отдельное приложение, не то, в которое смена вносит деньги. Разделены
# намеренно: сбой чтения Telegram не должен мешать вносить чаевые в зале.

FROM python:3.12-slim

WORKDIR /app

# Сначала только список зависимостей: пока он не менялся, Docker переиспользует
# уже скачанное и не ставит всё заново при каждой правке кода.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./

# Журнал должен появляться сразу, а не копиться в буфере: иначе в панели
# Amvera пусто ровно тогда, когда хочется понять, что происходит.
ENV PYTHONUNBUFFERED=1

CMD ["python3", "service.py"]
